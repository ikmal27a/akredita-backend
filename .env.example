# Salin file ini ke .env lalu isi nilainya

# PostgreSQL connection string
DATABASE_URL="postgresql://akredita:akredita@localhost:5432/akredita?schema=public"

# JWT secret — generate dengan: openssl rand -hex 32
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# File upload — gunakan local disk atau S3-compatible
UPLOAD_MODE=local         # local | s3
UPLOAD_DIR=./uploads      # untuk mode local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI integration — proxy untuk fitur Akredita AI
AI_PROVIDER=anthropic     # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# CORS — domain frontend yang diizinkan
CORS_ORIGIN=http://localhost:5173,https://akredita.example.com
